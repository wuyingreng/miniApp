<!-- index.wxml -->
<scroll-view class="scrollarea" scroll-y type="list">
  <swiper class="swiper" indicator-dots indicator-active-color="#f3514f" indicator-color="#fff" circular autoplay="">
    <swiper-item>
      <image src="../../assets/banner/banner-1.png" mode="aspectFill" show-menu-by-longpress />
    </swiper-item>
    <swiper-item>
      <image src="../../assets/banner/banner-2.png" mode="aspectFill" show-menu-by-longpress />
    </swiper-item>
    <swiper-item>
      <image src="../../assets/banner/banner-3.png" mode="aspectFill" show-menu-by-longpress />
    </swiper-item>
  </swiper>
  <!-- 帮我添加如下代码，写一个Button -->
  <view class="info">
    <view class="info-item">
      <text class="iconfont icon-peisong"></text>
      <text user-select space="ensp">同城配送</text>
    </view>
    <view class="info-item">
      <text class="iconfont icon-long"></text>
      <text user-select space="ensp">行业龙头</text>
    </view>
    <view class="info-item">
      <text class="iconfont icon-yisongda"></text>
      <text user-select space="ensp">半小时送达</text>
    </view>
    <view class="info-item">
      <text class="iconfont icon-haoping"></text>
      <text user-select space="ensp">好评如潮</text>
    </view>
  </view>
  <view class="navs">
    <view>
      <navigator url="/modules/goodModule/pages/list/list" redirect>
        <image src="../../assets/category/cate-2.png" />
        <text>进入list页面</text>
      </navigator>
    </view>
    <view>
      <navigator url="/modules/goodModule/pages/list/list">
        <image src="../../assets/category/cate-2.png" alt="" />
        <text>鲜花玫瑰</text>
      </navigator>
    </view>
    <view>
      <navigator url="/pages/list/list">
        <image src="../../assets/category/cate-3.png" alt="" />
        <text>永生玫瑰</text>
      </navigator>
    </view>
    <view>
      <navigator url="/pages/list/list">
        <image src="../../assets/category/cate-4.png" alt="" />
        <text>玫瑰珠宝</text>
      </navigator>
    </view>
    <view>
      <navigator url="/pages/list/list">
        <image src="/assets/category/cate-5.png" alt="" />
        <text>香水护体</text>
      </navigator>
    </view>
  </view>
  <view class="good-hot">
    <scroll-view scroll-x class="scroll-x">
      <view class="good-item">
        <!-- 前面要加/写根路径 -->
        <navigator url="/modules/marketModule/pages/market/market">
          <image src="../../assets/floor/1.png" mode="" />
          <text>进入market页面</text>
          <text>66</text>
        </navigator>
      </view>
      <view class="good-item">
        <image src="../../assets/floor/2.png" mode="" />
        <text>鲜花玫瑰</text>
        <text>77</text>
      </view>
      <view class="good-item">
        <image src="../../assets/floor/3.png" mode="" />
        <text>鲜花玫瑰</text>
        <text>88</text>
      </view>
      <view class="good-item">
        <image src="../../assets/floor/4.png" mode="" />
        <text>鲜花玫瑰</text>
        <text>99</text>
      </view>
      <view class="good-item">
        <image src="../../assets/floor/5.png" mode="" />
        <text>鲜花玫瑰</text>
        <text>100</text>
      </view>
    </scroll-view>
  </view>
  <view class="bg-image"></view>
  <!-- wxml语法 -->
  <text>下面展示wxml语法</text>
  <!-- 展示内容 -->
  <view>{{ school }}</view>
  <view>{{obj.name}}</view>
  <!-- 绑定属性值，如果需要动态绑定一个变量，属性值也需要使用双大括号进行包裹 
  这里和vue不一样，vue是i:id="id" -->
  <view id="{{ id }}">绑定属性值</view>
  <!-- 如果属性值是布尔值，也需要使用双大括号进行包裹 -->
  <checkbox checked="{{ isChecked }}" />
  <!-- 算术运算 -->
  <view>{{ id + 1 }}</view>
  <view>{{ id - 1 }}</view>
  <!-- 三元运算 -->
  <view>{{ id === 1 ? '等于' : '不等于' }}</view>
  <!-- 逻辑判断 -->
  <view>{{ id === 1 }}</view>
  <!-- 在双大括号写法内部，只能写表达式，不能写语句，也不能调用 js 的方法
    表达式是得到一个值，语句是执行某些操作 -->
  <!-- <view>{{ if (id === 1) {} }}</view> -->
  <!-- <view>{{ for (const i = 0; i <= 10; i++) {} }}</view> -->
  <view>{{ obj && obj.name }}</view>
  <view class="line"></view>
  <view>下面进行数据请求</view>
  <button type="warn" bindtap="fetchBanner">请求banner</button>
  <view class="line"></view>
  <custom-checkbox label="匿名提交" position="left" class="my-class" checked bind:changechecked="getData" class="custom">
    匿名提交 - 222
  </custom-checkbox>
  <custom-checkbox position="right" class="my-class">匿名提交 - 222</custom-checkbox>
  <view class="custom">
    <custom-checkbox position="right" class="my-class">匿名提交 - 222</custom-checkbox>
  </view>
  <button bindtap="getChildComponent" type="primary" plain>获取组件实例</button>
  <van-image width="100" height="100" src="/assets/bgimage.png" fit="contain" use-loading-slot use-error-slot custom-class='image-container' round bind:click="imageHandler">
    <van-loading slot="loading" type="spinner" size="20" vertical />
    <text slot="error">加载失败</text>
  </van-image>
  <custom01 />
  <button type="warn" bindtap="goList">跳转进入list页面</button>
</scroll-view>